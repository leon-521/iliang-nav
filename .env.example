# Generate a fresh secret: node -p "require('node:crypto').randomBytes(48).toString('base64url')"
AUTH_SECRET=
DATABASE_PATH=./data/app.db
PUBLIC_BASE_URL=http://localhost:3000

# Optional mail delivery for password resets.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
